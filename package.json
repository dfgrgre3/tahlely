{
  "name": "tahlely",
  "version": "0.1.0",
  "private": true,
  "description": "Tahlely — Desktop AI Engineering Platform (Prompt 1: master foundation)",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tahlely/desktop",
    "build": "npm run build --workspace @tahlely/desktop",
    "preview": "npm run preview --workspace @tahlely/desktop",
    "tauri": "npm run tauri --workspace @tahlely/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
